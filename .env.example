# ── API 密钥（SM4 加密，国密标准）────────────────────────────────────────────
#
# 密钥请先加密后填写，禁止明文存储：
#   python -m diligence.keys encode <明文密钥>   → 输出 SM4:Base64 串
#   python -m diligence.keys check               → 检查 .env 中各 key 的加密状态
#
# 明文在运行时仍可兼容，但违反规范。

# ── 搜索层（不可替换）──────────────────────────────────────────────────────
MINIMAX_API_KEY=SM4:<encrypted>
MINIMAX_BASE_URL=https://api.minimax.io/v1

# 秘塔 AI 搜索（可选，启用后补充精准问答）
METASO_API_KEY=
METASO_ENABLED=false

# ── 推理层（可替换为任意 OpenAI 兼容模型）────────────────────────────────
# 不填 LLM_API_KEY 则自动复用 MINIMAX_API_KEY（向后兼容）
LLM_API_KEY=
LLM_BASE_URL=https://api.minimax.io/v1
LLM_MODEL=MiniMax-M2.7-Highspeed

# 使用 DeepSeek 示例：
# LLM_API_KEY=SM4:<encrypted>
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat

# ── SQL 缓存（可选）：L1 MiniMax Search + L2 crawl4ai markdown ─────────────
# 本地开发可用 SQLite；多人协作/生产建议 PostgreSQL。
CACHE_ENABLED=false
CACHE_DATABASE_URL=sqlite+aiosqlite:///cache/diligence_cache.db
# CACHE_DATABASE_URL=postgresql+asyncpg://user:password@host:5432/xft_cache
CACHE_CREATE_TABLES=true
CACHE_POLICY_VERSION=v1-202605
CACHE_WORKER_ID=local-dev

SEARCH_CACHE_ENABLED=true
SEARCH_CACHE_TTL_DAYS=14

FETCH_CACHE_ENABLED=true
FETCH_CACHE_TTL_DAYS=30
FETCH_FAILED_RETRY_HOURS=24
FETCH_CACHE_LOCK_MINUTES=10
